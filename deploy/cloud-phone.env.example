# /etc/cloud-phone.env (root:root 0600)
PORT=18100
BASE_PATH=/beta
ALLOWED_ORIGINS=https://mobile.ai-ing.org
APP_DATA=/var/lib/cloud-phone
SEAT_DATA=/home/ubuntu/phone-seats
SEAT_COUNT=10
MAX_RUNNING=2
IDLE_SLEEP_MIN=30
ANDROID_IMAGE=cloud-phone-android:12
# AI. Now Gemini; later the Meta Model API through AI_PROVIDER=openai-compatible.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
