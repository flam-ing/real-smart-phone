# /etc/real-smart-phone.env (root:root 0600)
PORT=18100
BASE_PATH=
ALLOWED_ORIGINS=https://mobile.ai-ing.org
APP_DATA=/var/lib/real-smart-phone
SEAT_DATA=/home/ubuntu/phone-seats
SEAT_COUNT=10
MAX_RUNNING=2
IDLE_SLEEP_MIN=30
ANDROID_IMAGE=real-smart-phone-android:12
# AI: Muse Spark on the Meta Model API. muse-spark-1.3-contributor is cheaper but lets Meta train on prompts (screenshots).
AI_PROVIDER=meta
AI_MODEL=muse-spark-1.3
MODEL_API_KEY=
# Or: AI_PROVIDER=gemini with GEMINI_API_KEY and AI_MODEL=gemini-2.5-flash-lite
